(in-package #:cl-user)
(defpackage #:rove/core/parametrize
  (:use #:cl)
  (:import-from #:rove/core/test
                #:deftest)
  (:import-from #:rove/core/suite/package
                #:remove-test)
  (:export #:deftest-parametrize
           #:parametrize-test-name))
(in-package #:rove/core/parametrize)

(defvar *parametrized-tests* (make-hash-table :test 'eq)
  "BASE name → test names generated by its most recent DEFTEST-PARAMETRIZE.")

(defun parametrize-test-name (base index &optional id)
  "Return a symbol for a parametrized row: BASE/INDEX or BASE/ID."
  (check-type base symbol)
  (let* ((package (or (symbol-package base) *package*))
         (suffix (if id
                     (string-upcase (princ-to-string id))
                     (princ-to-string index))))
    (intern (format nil "~A/~A" (symbol-name base) suffix) package)))

(defun register-parametrized-tests (base names)
  "Record NAMES as BASE's current rows and unregister rows left over from a
previous definition, so shrinking the table does not keep stale tests running."
  (dolist (stale (set-difference (gethash base *parametrized-tests*) names))
    (remove-test stale))
  (setf (gethash base *parametrized-tests*) names)
  base)

(defun check-no-duplicates (items what)
  (let ((seen '()))
    (dolist (item items)
      (when (member item seen :test #'equal)
        (error "DEFTEST-PARAMETRIZE: duplicate ~A ~S" what item))
      (push item seen))))

(defun normalize-vars (vars-form)
  (let ((vars (cond
                ((and (symbolp vars-form) vars-form)
                 (list vars-form))
                ((and (consp vars-form) (every #'symbolp vars-form))
                 vars-form)
                (t
                 (error "DEFTEST-PARAMETRIZE: vars must be a symbol or list of symbols, got ~S"
                        vars-form)))))
    (dolist (var vars)
      (when (or (null var) (keywordp var) (constantp var))
        (error "DEFTEST-PARAMETRIZE: ~S cannot be bound as a parameter" var)))
    (check-no-duplicates vars "variable")
    vars))

(defun normalize-row (vars row)
  "Coerce ROW to a value list matching VARS."
  (let ((values
          (cond
            ((= (length vars) 1)
             (cond
               ((and (consp row) (null (cdr row)))
                row)
               ((and (consp row) (listp (cdr row)) (cdr row))
                (error "DEFTEST-PARAMETRIZE: row ~S has ~D values, expected 1"
                       row (length row)))
               (t (list row))))
            ((and (consp row) (listp (cdr row)))
             row)
            (t
             (error "DEFTEST-PARAMETRIZE: row ~S is not a list" row)))))
    (unless (= (length values) (length vars))
      (error "DEFTEST-PARAMETRIZE: row ~S has ~D values, expected ~D for ~S"
             row (length values) (length vars) vars))
    values))

(defun check-ids (ids rows)
  (when ids
    (unless (listp ids)
      (error "DEFTEST-PARAMETRIZE: :ids must be a list, got ~S" ids))
    (unless (= (length ids) (length rows))
      (error "DEFTEST-PARAMETRIZE: :ids length ~D does not match ~D rows"
             (length ids) (length rows)))
    (check-no-duplicates (mapcar (lambda (id) (string-upcase (princ-to-string id))) ids)
                         "id")))

(defun parse-bindings (bindings)
  "Parse BINDINGS → (values vars ids-form rows-form literal-rows).
ROWS-FORM is the :rows form when given, otherwise LITERAL-ROWS holds the rows."
  (unless (consp bindings)
    (error "DEFTEST-PARAMETRIZE: bindings must be a list, got ~S" bindings))
  (let ((vars (normalize-vars (first bindings)))
        (rest (rest bindings))
        (ids-form nil)
        (rows-form nil)
        (seen '()))
    (loop while (and rest (keywordp (first rest)))
          do (let ((key (first rest)))
               (when (member key seen)
                 (error "DEFTEST-PARAMETRIZE: ~S given more than once" key))
               (push key seen)
               (unless (cdr rest)
                 (error "DEFTEST-PARAMETRIZE: ~S is missing its value" key))
               (case key
                 (:ids (setf ids-form (second rest)))
                 (:rows (setf rows-form (list (second rest))))
                 (t (error "DEFTEST-PARAMETRIZE: unknown option ~S (expected :ids or :rows)" key)))
               (setf rest (cddr rest))))
    (when (and rows-form rest)
      (error "DEFTEST-PARAMETRIZE: cannot mix :rows with literal rows"))
    (when (and (null rows-form) (null rest))
      (error "DEFTEST-PARAMETRIZE: no parameter rows given"))
    (values vars ids-form (first rows-form) rest)))

(defun literal-ids-p (ids-form)
  "True when IDS-FORM is written as data, e.g. (\"a\" \"b\") or '(\"a\" \"b\")."
  (or (null ids-form)
      (and (consp ids-form)
           (or (eq (first ids-form) 'quote)
               (every #'atom ids-form)))))

(defun ids-list (ids-form)
  (cond
    ((null ids-form) nil)
    ((and (consp ids-form) (eq (first ids-form) 'quote))
     (second ids-form))
    ((listp ids-form) ids-form)
    (t
     (error "DEFTEST-PARAMETRIZE: :ids must be a list, got ~S" ids-form))))

(defun ids-form-for-eval (ids-form)
  "Make :IDS evaluate to the same list whether rows are literal or from :ROWS."
  (if (and (consp ids-form) (not (eq (first ids-form) 'quote)) (every #'atom ids-form))
      `',ids-form
      ids-form))

(defun expand-parametrized-deftest (name-form vars values body)
  `(deftest ,name-form
     (let ,(mapcar #'list vars values)
       ,@body)))

(defmacro deftest-parametrize (name-and-options bindings &body body)
  "Define one test per parameter row.

Syntax:

  (deftest-parametrize name-and-options
      ((var*) [:ids ids] [:rows form] row*)
    body*)

NAME-AND-OPTIONS is the same as DEFTEST: NAME or (NAME :compile-at … :marks … :timeout …).

Each ROW is a list of values for VAR*, or a single value when there is
one variable. Tests are registered as NAME/0, NAME/1, … unless :ids
supplies per-row suffixes (NAME/ID). Ids must be unique after upcasing.

:rows FORM evaluates FORM at load/execute time; the value must be a
list of rows. This is for tables that are not literal constants.
:ids written as a literal list is taken as data in both cases; any
other :ids form is evaluated together with :rows.

Redefining NAME with fewer rows unregisters the rows that disappeared.

Examples:

  (deftest-parametrize add
      ((a b expected)
       (1 2 3)
       (0 0 0))
    (ok (= (+ a b) expected)))

  (deftest-parametrize doubles
      ((n expected) :ids (\"two\" \"four\")
       (1 2)
       (2 4))
    (ok (= (* n 2) expected)))"
  (destructuring-bind (base &rest deftest-options)
      (if (consp name-and-options)
          name-and-options
          (list name-and-options))
    (check-type base symbol)
    (multiple-value-bind (vars ids-form rows-form literal-rows)
        (parse-bindings bindings)
      (if rows-form
          ;; Dynamic table — register via DEFTEST so compile-at / hooks stay shared.
          (let ((rows-var (gensym "ROWS"))
                (ids-var (gensym "IDS"))
                (index-var (gensym "INDEX"))
                (row-var (gensym "ROW"))
                (values-var (gensym "VALUES"))
                (test-var (gensym "TEST"))
                (id-var (gensym "ID"))
                (name-form-var (gensym "NAME-FORM")))
            `(eval-when (:load-toplevel :execute)
               (let ((,rows-var ,rows-form)
                     (,ids-var ,(ids-form-for-eval ids-form)))
                 (unless (listp ,rows-var)
                   (error "DEFTEST-PARAMETRIZE: :rows must evaluate to a list, got ~S"
                          ,rows-var))
                 (check-ids ,ids-var ,rows-var)
                 (register-parametrized-tests
                  ',base
                  (loop for ,row-var in ,rows-var
                        for ,index-var from 0
                        for ,id-var = (when ,ids-var (nth ,index-var ,ids-var))
                        for ,values-var = (normalize-row ',vars ,row-var)
                        for ,test-var = (parametrize-test-name ',base ,index-var ,id-var)
                        for ,name-form-var = (if ',deftest-options
                                                 (list* ,test-var ',deftest-options)
                                                 ,test-var)
                        do (eval (expand-parametrized-deftest
                                  ,name-form-var ',vars ,values-var ',body))
                        collect ,test-var)))))
          (let ((ids (ids-list ids-form)))
            (check-ids ids literal-rows)
            (let ((names (loop for index from 0 below (length literal-rows)
                               for id = (when ids (nth index ids))
                               collect (parametrize-test-name base index id))))
              `(progn
                 ,@(loop for row in literal-rows
                         for test-symbol in names
                         for values = (normalize-row vars row)
                         for name-form = (if deftest-options
                                             (list* test-symbol deftest-options)
                                             test-symbol)
                         collect (expand-parametrized-deftest name-form vars values body))
                 (register-parametrized-tests ',base ',names))))))))
